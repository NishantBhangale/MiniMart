# --- Server ---
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# --- Postgres (source of truth: products, orders, users) ---
PGHOST=postgres
PGPORT=5432
PGUSER=minimart
PGPASSWORD=change_me_strong_password
PGDATABASE=minimart

# --- Redis (stock counters, cart TTL, sessions) ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Cart behaviour ---
CART_TTL_SECONDS=1800
